# Copy this file to .env and fill it in. NEVER commit the real .env.

# --- Email alerts ---
# SMTP is the standard protocol for sending mail.
# USE GMAIL to send. Personal Hotmail/Outlook no longer works: Microsoft turned
# off password-based sending ("basic authentication is disabled"). The watcher
# sends through Gmail; alerts can land in whatever inbox you want.
# App password: enable 2-step verification in Gmail, then create an app password
# at myaccount.google.com/apppasswords (16 letters, paste without spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fill-in-robot-account@gmail.com
SMTP_PASSWORD=fill-in-16-letter-app-password
ALERTA_EMAIL_PARA=you@example.com
# Hour (0-23) for the daily "I'm alive" summary. Default 18 (6 pm).
RESUMO_DIARIO_HORA=18

# --- Data sources (all free) ---
# INPE is Brazil's National Institute for Space Research. This endpoint publishes
# satellite hotspots for the whole country every 10 minutes.
# Kept in an env var because it is a third party that can change the address.
INPE_10MIN_URL=https://dataserver-coids.inpe.br/queimadas/queimadas/focos/csv/10min/
# Free NASA FIRMS key: create one at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=fill-in-free-key
# CAR geoserver (Brazil's Rural Environmental Registry) — official farm polygons
SICAR_WFS_URL=https://geoserver.car.gov.br/geoserver/sicar/ows
